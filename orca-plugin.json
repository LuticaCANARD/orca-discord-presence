{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "discord-presence",
  "publisher": "lutica-canard",
  "name": "Discord Presence",
  "version": "0.4.0",
  "description": "Publishes what your Orca agent fleet is doing to your Discord status via local Rich Presence IPC.",
  "author": { "name": "Lutica_CANARD" },
  "repository": "https://github.com/LuticaCANARD/orca-discord-presence",
  "engines": { "orca": ">=1.4.246" },
  "pluginApi": 1,
  "main": "dist/main.mjs",
  "contributes": {
    "commands": [
      { "id": "presence.toggle", "title": "Discord Presence: Toggle" },
      {
        "id": "presence.privacy",
        "title": "Discord Presence: Cycle Privacy Level"
      },
      { "id": "presence.header", "title": "Discord Presence: Set Header" },
      { "id": "presence.reconnect", "title": "Discord Presence: Reconnect" },
      {
        "id": "presence.status",
        "title": "Discord Presence: Show Connection Status"
      }
    ],
    "events": [
      { "on": "workspace.created" },
      { "on": "workspace.removed" },
      { "on": "agent.status.changed" },
      { "on": "workspace.changed" }
    ],
    "settings": [
      { "key": "enabled", "title": "Publish Discord presence", "type": "boolean", "default": true },
      {
        "key": "privacy",
        "title": "Privacy",
        "type": "string",
        "enum": ["minimal", "full", "off"],
        "enumLabels": ["Counts only", "Include workspace and branch names", "Off"],
        "default": "minimal"
      },
      {
        "key": "header",
        "title": "Header",
        "description": "Use {workspace} or {branch} for names in Full privacy. Leave blank to hide the custom header.",
        "type": "string",
        "default": "Orca"
      },
      {
        "key": "clientId",
        "title": "Discord application ID",
        "description": "Leave blank to use the bundled Discord application.",
        "type": "string",
        "default": ""
      },
      { "key": "largeImage", "title": "Logo asset key", "type": "string", "default": "orca" },
      { "key": "largeText", "title": "Logo tooltip", "type": "string", "default": "Orca" },
      { "key": "smallImage", "title": "Badge asset key", "type": "string", "default": "" },
      { "key": "smallText", "title": "Badge tooltip", "type": "string", "default": "" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "notifications:show" }
  ]
}
