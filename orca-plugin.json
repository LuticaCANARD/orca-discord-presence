{
  "manifestVersion": 1,
  "id": "discord-presence",
  "publisher": "lutica-canard",
  "name": "Discord Presence",
  "version": "0.1.0",
  "description": "Publishes what your Orca agent fleet is doing to your Discord status via local Rich Presence IPC.",
  "author": { "name": "Lutica_CANARD" },
  "repository": "https://github.com/LuticaCANARD/orca-discord-presence",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "dist/main.mjs",
  "contributes": {
    "commands": [
      { "id": "presence.toggle", "title": "Discord Presence: Toggle" },
      { "id": "presence.privacy", "title": "Discord Presence: Cycle Privacy Level" },
      { "id": "presence.status", "title": "Discord Presence: Show Connection Status" }
    ],
    "events": [
      { "on": "worktree.created" },
      { "on": "worktree.removed" },
      { "on": "agent.status.changed" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "events:subscribe" },
    { "kind": "storage" },
    { "kind": "settings:own" },
    { "kind": "notifications:show" }
  ]
}
